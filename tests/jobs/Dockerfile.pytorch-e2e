ARG RAY_BASE
FROM ${RAY_BASE}
USER root
ARG VENV_PATH=/opt/tributo-e2e/venv
ENV VIRTUAL_ENV=${VENV_PATH}
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}" \
    OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 RAY_USAGE_STATS_ENABLED=0 \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN test -x "${VIRTUAL_ENV}/bin/python" || python -m venv "${VIRTUAL_ENV}"
COPY requirements.txt /opt/tributo-e2e/requirements.txt
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_DEFAULT_TIMEOUT=15
RUN --mount=type=cache,target=/home/ray/.cache/pip \
    PIP_INDEX_URL="${PIP_INDEX_URL}" PIP_DEFAULT_TIMEOUT="${PIP_DEFAULT_TIMEOUT}" \
    python -m pip install --require-hashes -r /opt/tributo-e2e/requirements.txt
COPY wheels/ /opt/tributo-e2e/wheels/
RUN python -m pip install --no-deps --force-reinstall /opt/tributo-e2e/wheels/*.whl && \
    python -m pip check
RUN mkdir /e2e && chown ray:users /e2e
USER ray
WORKDIR /e2e
